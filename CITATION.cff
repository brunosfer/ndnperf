    given-names: "Bruno"
    email: "bruno.fernandes@tum.de"
    orcid: "https://orcid.org/0009-0008-5898-9698"
    affiliation: "Technical University of Munich"
license: GPL-3.0-or-later
repository-code: "https://github.com/brunosfer/ndnperf"
keywords:
  - named-data networking
  - NDN
  - performance
  - benchmark
  - ndn-cxx
